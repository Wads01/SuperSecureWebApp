generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model PasswordHistory {
  id           String   @id @db.Uuid
  userId       String   @db.Uuid
  passwordHash String
  createdAt    DateTime @default(now())
  User         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Scope {
  id        String   @id @db.Uuid
  name      String   @unique @db.VarChar(120)
  createdAt DateTime @default(now())
  updatedAt DateTime
  Task      Task[]
  User      User[]
}

model SecurityLog {
  id           String               @id @db.Uuid
  actorUserId  String?              @db.Uuid
  eventType    SecurityEventType
  outcome      SecurityEventOutcome
  route        String?              @db.VarChar(255)
  resourceType String?              @db.VarChar(80)
  resourceId   String?              @db.VarChar(120)
  ip           String?              @db.VarChar(64)
  userAgent    String?
  metadataJson Json?
  createdAt    DateTime             @default(now())
  User         User?                @relation(fields: [actorUserId], references: [id])

  @@index([actorUserId])
  @@index([createdAt])
  @@index([eventType, outcome])
}

model Session {
  id               String   @id @db.Uuid
  userId           String   @db.Uuid
  sessionTokenHash String   @unique
  expiresAt        DateTime
  createdAt        DateTime @default(now())
  lastSeenAt       DateTime @default(now())
  ip               String?  @db.VarChar(64)
  userAgent        String?
  User             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([userId])
}

model Task {
  id                          String     @id @db.Uuid
  title                       String     @db.VarChar(140)
  description                 String?
  status                      TaskStatus @default(OPEN)
  ownerUserId                 String     @db.Uuid
  managerId                   String?    @db.Uuid
  scopeId                     String?    @db.Uuid
  createdById                 String?    @db.Uuid
  updatedById                 String?    @db.Uuid
  createdAt                   DateTime   @default(now())
  updatedAt                   DateTime
  User_Task_createdByIdToUser User?      @relation("Task_createdByIdToUser", fields: [createdById], references: [id])
  User_Task_managerIdToUser   User?      @relation("Task_managerIdToUser", fields: [managerId], references: [id])
  User_Task_ownerUserIdToUser User       @relation("Task_ownerUserIdToUser", fields: [ownerUserId], references: [id])
  Scope                       Scope?     @relation(fields: [scopeId], references: [id])
  User_Task_updatedByIdToUser User?      @relation("Task_updatedByIdToUser", fields: [updatedById], references: [id])

  @@index([managerId])
  @@index([ownerUserId])
  @@index([scopeId])
  @@index([status])
}

model User {
  id                          String            @id @db.Uuid
  email                       String            @unique @db.VarChar(320)
  role                        UserRole
  status                      UserStatus        @default(ACTIVE)
  passwordHash                String
  failedLoginCount            Int               @default(0)
  lockoutUntil                DateTime?
  passwordChangedAt           DateTime          @default(now())
  lastLoginAt                 DateTime?
  lastLoginSuccessAt          DateTime?
  lastLoginFailureAt          DateTime?
  scopeId                     String?           @db.Uuid
  createdAt                   DateTime          @default(now())
  updatedAt                   DateTime
  resetAnswerHash             String?
  resetQuestion               String?           @db.VarChar(200)
  PasswordHistory             PasswordHistory[]
  SecurityLog                 SecurityLog[]
  Session                     Session[]
  Task_Task_createdByIdToUser Task[]            @relation("Task_createdByIdToUser")
  Task_Task_managerIdToUser   Task[]            @relation("Task_managerIdToUser")
  Task_Task_ownerUserIdToUser Task[]            @relation("Task_ownerUserIdToUser")
  Task_Task_updatedByIdToUser Task[]            @relation("Task_updatedByIdToUser")
  Scope                       Scope?            @relation(fields: [scopeId], references: [id])

  @@index([role])
  @@index([scopeId])
  @@index([status])
}

enum SecurityEventOutcome {
  SUCCESS
  FAILURE
  DENIED
}

enum SecurityEventType {
  AUTH_LOGIN
  AUTH_LOGOUT
  AUTH_REGISTER
  AUTH_PASSWORD_CHANGE
  AUTH_PASSWORD_RESET
  AUTH_REAUTH
  AUTH_LOCKOUT
  AUTHZ_ACCESS
  VALIDATION
  TASK_CRUD
  USER_MANAGEMENT
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  DONE
  ARCHIVED
}

enum UserRole {
  ADMIN
  MANAGER
  USER
}

enum UserStatus {
  ACTIVE
  LOCKED
  DISABLED
}
